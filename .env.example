# .env.example — every environment variable the app reads (via python-decouple config()).
# Copy to .env and fill in real values. Keys with a safe default in settings.py are
# optional; secrets (DB, API keys, bot tokens, SECRET_KEY, VAPID_PRIVATE_KEY) are required for prod.
# Generated from a scan of settings.py + daily/; keep in sync when adding a config() call.

# --- Core Django ---
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# --- Database (SHARED prod Postgres; use a LOCAL db for dev) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Production: same-VPC managed PostgreSQL hostname; takes precedence over DB_HOST.
DB_PRIVATE_HOST=
# Production WSGI connection lifetime in seconds (local DEBUG defaults to 0).
DB_CONN_MAX_AGE=60
BOT_READONLY_DB_USER=
BOT_READONLY_DB_PASSWORD=

# --- AI providers (billed) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# --- Telegram / Discord / X / Strava ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ATTESTATION_CHANNEL_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ADMIN_ROLE_NAME=
DISCORD_ATTESTATION_CHANNEL_ID=
DISCORD_TOP_5_CHANNEL_ID=
DISCORD_TOP_5_ROLE_NAME=
DISCORD_TOP_10_CHANNEL_ID=
DISCORD_TOP_10_ROLE_NAME=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Daily app (PWA push + LLM backend) ---
DAILY_APP_BASE_URL=
DAILY_LLM_BACKEND=
DAILY_LLM_CLAUDE_CLI_MODEL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VIEWER_TELEGRAM_ID=

# --- Attestation + conversational bot tuning (all have safe defaults) ---
ATTESTATION_MIN_LENGTH=
ATTESTATION_MULTI_PART_WINDOW_MINUTES=
ATTESTATION_WEEKEND_START_HOUR=
BOT_QUERY_MODE=
BOT_SCOPE=
CONVERSATION_REPLIES_ENABLED=
CONVERSATION_REPLIES_DM_ONLY=
CONVERSATION_CLASSIFIER_ENABLED=
CONVERSATION_CLASSIFIER_MODEL=
CONVERSATION_HISTORY_TURNS=
CONVERSATION_CACHE_TTL=
CONVERSATION_GLOBAL_CONCURRENCY=
CONVERSATION_PER_CHAT_COOLDOWN_SEC=
CONVERSATION_AMBIENT_PER_CHAT_PER_HOUR=
CONVERSATION_CLAUDE_CLI_PATH=
CONVERSATION_CLAUDE_TIMEOUT_SEC=
CONVERSATION_CLAUDE_CIRCUIT_HOURS=
CONVERSATION_CODEX_CLI_PATH=
CONVERSATION_DRY_RUN_ATTESTATIONS=
